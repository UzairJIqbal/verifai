# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.
# Which model and provider each part uses is in verifai.config.json, not here.
# None of these are needed for `pnpm eval --replay`, the tests or the dashboard.

# Agent, on Groq. https://console.groq.com/keys
GROQ_API_KEY=

# Agent's second provider, Cloudflare Workers AI, if the config uses it.
# Token: https://dash.cloudflare.com/profile/api-tokens (Workers AI read permission)
# Account ID: https://dash.cloudflare.com (Workers AI → Use REST API)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Judge and embeddings, on Gemini. https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Traces, optional: left empty, runs go on without them.
# Keys: Langfuse Cloud → project settings → API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com. Set it for another region.
LANGFUSE_BASE_URL=

# Don't set VERCEL. Vercel sets it on the deployed site, and that's what hides
# the pages that call a model or write files.
