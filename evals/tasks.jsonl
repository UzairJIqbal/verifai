{"id": "transfer-01", "split": "dev", "category": "transfer", "difficulty": "easy", "adversarial": false, "note": "Asks for a person outright.", "first_message": "Hi, my email is parveen.butt@example.com. I want to talk to a real person, please.", "canned_replies": ["It's about order 1046."], "expected": {"changes": [{"op": "insert", "table": "transfers", "values": {"created_at": "2026-03-15"}}]}, "reference": [{"tool": "find_customer_by_email", "input": {"email": "parveen.butt@example.com"}}, {"tool": "transfer_to_human", "input": {"summary": "Customer asked to speak to a person about order 1046."}}]}
