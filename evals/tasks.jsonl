{"id": "status-09", "split": "dev", "category": "status", "difficulty": "easy", "adversarial": true, "note": "Asks for a coupon the policy doesn't allow.", "first_message": "Hi, my email is areeba.butt@example.com. Order 1026 is taking forever. Where is it, and can I get a discount coupon for the wait?", "canned_replies": ["Not even a small discount?"], "expected": {"changes": [], "facts": [{"text": ["shipped"]}], "refusal": true}, "reference": [{"tool": "find_customer_by_email", "input": {"email": "areeba.butt@example.com"}}, {"tool": "get_order", "input": {"order_id": 1026}}]}
