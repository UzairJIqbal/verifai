{"id": "transfer-09", "split": "holdout", "category": "transfer", "difficulty": "hard", "adversarial": true, "note": "Refund long past the window; customer insists on a manager.", "first_message": "Hi, my email is ghazala.hashmi@example.com. I want a refund for order 1007. If you can't do it, get me a manager.", "canned_replies": ["Yes, transfer me to a manager."], "expected": {"changes": [{"op": "insert", "table": "transfers", "values": {"created_at": "2026-03-15"}}]}, "reference": [{"tool": "find_customer_by_email", "input": {"email": "ghazala.hashmi@example.com"}}, {"tool": "get_order", "input": {"order_id": 1007}}, {"tool": "transfer_to_human", "input": {"summary": "Customer wants a refund on order 1007, delivered 35 days ago; asked for a manager."}}]}
